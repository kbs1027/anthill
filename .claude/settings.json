{
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-git.sh\"; [ -f \"$f\" ] && exec bash \"$f\"; exit 0"
          }
        ]
      }
    ]
  }
}
